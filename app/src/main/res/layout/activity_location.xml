<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:background="@color/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/location_title" app:titleTextColor="@color/ink"/>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/instructions" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Body" android:text="@string/map_instructions"/>
            <com.marioespinoza.mibalance.ui.ExpenseMapView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/attribution" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Body" android:text="@string/map_attribution" android:minHeight="48dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Body" android:text="@string/map_status"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/latitudeLayout" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/latitude">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/latitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/longitudeLayout" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/longitude">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/longitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/apply" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/apply_coordinates" style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/useLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/use_location"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
