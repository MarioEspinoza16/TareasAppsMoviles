<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:background="@color/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/movements" app:titleTextColor="@color/ink"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="20dp" android:orientation="vertical">
        <EditText android:id="@+id/searchQuery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:maxLength="18" android:singleLine="true" android:hint="@string/search_id_hint"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/search_id"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/showAll" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/show_all" style="@style/Widget.Material3.Button.TextButton"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Body" android:text="@string/movements_hint" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/resultCount" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SectionTitle" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Body" android:text="@string/empty_transactions" android:layout_marginTop="12dp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/transactions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/add" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/new_transaction" android:layout_marginTop="12dp"/>
    </LinearLayout>
</LinearLayout>
