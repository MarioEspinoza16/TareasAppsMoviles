<?xml version="1.0" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
    <application android:name=".BalanceApplication" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@drawable/ic_wallet" android:label="@string/app_name" android:supportsRtl="true" android:theme="@style/Theme.MiBalance" android:usesCleartextTraffic="false">
        <activity android:name=".ui.LocationActivity" android:exported="false"/>
        <activity android:name=".ui.DetailActivity" android:exported="false"/>
        <activity android:name=".ui.TransactionEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.HistoryActivity" android:exported="false"/>
        <activity android:name=".ui.DashboardActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths"/>
        </provider>
        <service android:name="androidx.appcompat.app.AppLocalesMetadataHolderService" android:enabled="false" android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true"/>
        </service>
    </application>
</manifest>
